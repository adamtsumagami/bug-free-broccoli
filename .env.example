# ════════════════════════════════════════════════
#   AFK Selfbot — Konfigurasi
# ════════════════════════════════════════════════

# ─── WAJIB ──────────────────────────────────────
DISCORD_TOKEN=your_user_token_here

# ─── OPSIONAL ───────────────────────────────────

# Voice channel ID untuk auto-join saat startup
# VOICE_CHANNEL_ID=123456789012345678

# Owner Discord User ID (bisa lebih dari satu, pisahkan dengan koma)
# OWNER_IDS=123456789012345678,987654321098765432

# Delay reconnect voice channel dalam milidetik (default: 5000)
# RECONNECT_DELAY_MS=5000

# Level log: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ─── ACTIVITY / RICH PRESENCE ───────────────────

# Nama game yang ditampilkan (default: Grand Theft Auto VI)
# ACTIVITY_NAME=Grand Theft Auto VI

# RPC App ID di Discord Developer Portal (default: gtavi app)
# RPC_APP_ID=1546574770047291453

# Logo gambar besar. Pilihan:
#   gta6        → asset bernama "gta6" di Developer Portal Art Assets
#   <id>        → Snowflake ID asset dari Developer Portal
#   https://cdn.discordapp.com/attachments/...  → URL Discord CDN
#   none        → tanpa logo
# ACTIVITY_LARGE_IMAGE=gta6

# Hover tooltip saat kursor di atas logo (opsional)
# ACTIVITY_LARGE_TEXT=

# Teks baris kedua di bawah judul (kosongkan agar tidak muncul)
# ACTIVITY_DETAILS=

# ─── VOICE STATE ────────────────────────────────

# Status akun saat join voice channel
# VOICE_SELF_MUTE=true
# VOICE_SELF_DEAF=true
