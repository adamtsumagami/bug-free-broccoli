# ─── WAJIB ───────────────────────────────────────────
DISCORD_TOKEN=your_user_token_here
OWNER_ID=your_discord_user_id

# ─── OPSIONAL ────────────────────────────────────────
# Voice channel ID untuk auto-join saat startup
# VOICE_CHANNEL_ID=123456789012345678

# Delay reconnect dalam milidetik (default: 5000)
# RECONNECT_DELAY_MS=5000

# Level log: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Custom activity
# ACTIVITY_NAME=Grand Theft Auto VI
# ACTIVITY_TYPE=PLAYING

# Rich Presence dengan icon (opsional)
# Buat aplikasi di https://discord.com/developers/applications, lalu isi:
# RPC_APP_ID=123456789012345678
# URL gambar ATAU nama asset key dari Discord Developer Portal → Rich Presence → Art Assets
# Contoh pakai nama asset (rekomendasi): ACTIVITY_LARGE_IMAGE=gta6
# Contoh pakai URL eksternal:            ACTIVITY_LARGE_IMAGE=https://example.com/image.png
# ACTIVITY_LARGE_IMAGE=gta6
# ACTIVITY_LARGE_TEXT=Grand Theft Auto VI

# ─── TOP.GG AUTO VOTER ──────────────────────────────
# Set true untuk mengaktifkan auto-vote TempVoice setiap 12 jam
# TOPGG_VOTER_ENABLED=true
# Cookie sesi login top.gg manual (opsional jika ingin login manual tanpa OAuth)
# Ambil dari DevTools browser desktop (F12) -> Application -> Cookies -> https://top.gg -> __Secure-authjs.session-token
# TOPGG_COOKIE=your_session_token_here

# ─── VOICE STATE ────────────────────────────────
# Status default saat join voice channel (true/false)
# VOICE_SELF_MUTE=true
# VOICE_SELF_DEAF=true

