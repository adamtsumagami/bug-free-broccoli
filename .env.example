# ─── WAJIB ───────────────────────────────────────────
DISCORD_TOKEN=your_user_token_here

# ─── OPSIONAL ────────────────────────────────────────
# Voice channel ID untuk auto-join saat startup
# VOICE_CHANNEL_ID=123456789012345678

# Discord User ID owner (opsional untuk logging)
# OWNER_ID=your_discord_user_id

# Delay reconnect dalam milidetik (default: 5000)
# RECONNECT_DELAY_MS=5000

# Level log: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ─── ACTIVITY / RICH PRESENCE ────────────────────────
# Nama game yang ditampilkan (default: Grand Theft Auto VI)
# ACTIVITY_NAME=Grand Theft Auto VI

# RPC App ID di Discord Developer Portal (default: gtavi)
# RPC_APP_ID=1546574770047291453

# Logo gambar besar. Pilihan:
#   gta6               → asset "gta6" di Discord Developer Portal Art Assets
#   <asset-id>         → Snowflake ID dari Developer Portal
#   https://cdn.discordapp.com/attachments/...  → URL Discord CDN (upload ke Discord dulu)
#   none               → tanpa logo
# ACTIVITY_LARGE_IMAGE=gta6

# Hover tooltip pada logo (opsional)
# ACTIVITY_LARGE_TEXT=

# Teks baris kedua di bawah judul (opsional, biarkan kosong agar tidak muncul)
# ACTIVITY_DETAILS=

# ─── VOICE STATE ────────────────────────────────────
# Status default saat join voice channel (true = aktif, false = non-aktif)
# VOICE_SELF_MUTE=true
# VOICE_SELF_DEAF=true
