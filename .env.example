# ─── WAJIB ───────────────────────────────────────────
DISCORD_TOKEN=your_user_token_here
OWNER_ID=your_discord_user_id

# ─── OPSIONAL ────────────────────────────────────────
# Voice channel ID untuk auto-join saat startup
# VOICE_CHANNEL_ID=123456789012345678

# Delay reconnect dalam milidetik (default: 5000)
# RECONNECT_DELAY_MS=5000

# Level log: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Custom activity (default: Minecraft)
# ACTIVITY_NAME=Minecraft
# ACTIVITY_TYPE=PLAYING
